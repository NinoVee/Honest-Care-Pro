// Honest Care — Prisma schema (Phase 2/3/4/5 vertical slice)
//
// Scoped down from the full spec's 40+ table list to what this slice
// actually uses. Field/identifier naming stays FHIR-friendly (e.g.
// separate `externalIdentifiers` on Patient) so a FHIR mapping layer
// can be added later without renaming core columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  PHYSICIAN
  NURSE
  SCHEDULER
}

enum TreatmentPlanStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  ON_HOLD
  COMPLETED
  DISCONTINUED
}

enum VisitStatus {
  UNASSIGNED
  SCHEDULED
  CONFIRMED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
  RESCHEDULED
}

enum TabletStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
}

enum PatientStatus {
  ENROLLED
  DISCHARGED
}

enum AlertSeverity {
  INFORMATIONAL
  URGENT
  CRITICAL
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users    User[]
  patients Patient[]
}

model User {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  email          String
  role           UserRole
  createdAt      DateTime     @default(now())

  treatmentPlans TreatmentPlan[] @relation("OrderingPhysician")
  assignedVisits Visit[]         @relation("AssignedNurse")
  auditEvents    AuditLog[]

  @@unique([organizationId, email])
}

/// One tablet is assigned to at most one patient at a time. When a
/// patient is discharged, their tablet returns to AVAILABLE so it can
/// be assigned to the next enrolling patient — 20 tablets rotate across
/// however many patients pass through over time.
model Tablet {
  id         String       @id @default(uuid())
  identifier String       @unique // e.g. "TABLET-01"
  status     TabletStatus @default(AVAILABLE)
  createdAt  DateTime     @default(now())

  currentPatient Patient?
}

model Patient {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  medicalRecordNumber String?
  firstName            String
  middleName           String?
  lastName             String
  dateOfBirth          DateTime
  phone                String?
  email                String?
  addressLine          String?
  city                 String?
  state                String?
  postalCode           String?

  allergies   String[] @default([])
  precautions String[] @default([])

  status      PatientStatus @default(ENROLLED)
  enrolledAt  DateTime      @default(now())
  dischargedAt DateTime?

  assignedTablet   Tablet? @relation(fields: [assignedTabletId], references: [id])
  assignedTabletId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  treatmentPlans TreatmentPlan[]
  visits         Visit[]
  measurements   Measurement[]
  alerts         Alert[]
  auditEvents    AuditLog[]
}

model TreatmentPlan {
  id         String   @id @default(uuid())
  patient    Patient  @relation(fields: [patientId], references: [id])
  patientId  String

  physician   User   @relation("OrderingPhysician", fields: [physicianId], references: [id])
  physicianId String

  diagnosis            String
  treatmentType        String
  description          String
  instructions          String?
  frequency             String
  startDate             DateTime
  endDate               DateTime?
  requiredVitals        String[] @default([])
  notifyIfSystolicOver  Int?
  notifyIfSystolicUnder Int?
  notifyIfSpo2Under     Int?

  status       TreatmentPlanStatus @default(DRAFT)
  signedAt     DateTime?
  signedBy     String?

  previousVersionId String?
  version           Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits Visit[]
}

model Visit {
  id         String   @id @default(uuid())
  patient    Patient  @relation(fields: [patientId], references: [id])
  patientId  String

  treatmentPlan   TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])
  treatmentPlanId String?

  nurse   User?   @relation("AssignedNurse", fields: [nurseId], references: [id])
  nurseId String?

  serviceType String
  scheduledAt DateTime
  durationMin Int      @default(45)
  status      VisitStatus @default(UNASSIGNED)
  instructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  measurements Measurement[]
}

/// Every vital sign submitted from the iOS app for an enrolled patient.
/// This is what powers the web app's live vitals dashboard.
model Measurement {
  id         String   @id @default(uuid())
  patient    Patient  @relation(fields: [patientId], references: [id])
  patientId  String
  visit      Visit?   @relation(fields: [visitId], references: [id])
  visitId    String?

  kind       String   // "blood_pressure" | "spo2" | "weight" | "temperature" | "heart_rate" | "respiratory_rate" | "glucose" | "pain_scale"
  systolic   Int?
  diastolic  Int?
  value      Float?
  unit       String
  measuredAt DateTime @default(now())
  source     String   @default("ios_app")

  createdAt DateTime @default(now())
  alerts    Alert[]
}

/// Created automatically when a measurement crosses the active treatment
/// plan's configured thresholds. Requires explicit acknowledgment — no
/// silent alerts, matching the spec's alerting requirements.
model Alert {
  id            String    @id @default(uuid())
  patient       Patient   @relation(fields: [patientId], references: [id])
  patientId     String
  measurement   Measurement? @relation(fields: [measurementId], references: [id])
  measurementId String?

  severity       AlertSeverity
  description    String
  acknowledgedAt DateTime?
  acknowledgedBy String?

  createdAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?
  patient      Patient? @relation(fields: [patientId], references: [id])
  patientId    String?
  action       String
  resourceType String
  resourceId   String
  createdAt    DateTime @default(now())
}