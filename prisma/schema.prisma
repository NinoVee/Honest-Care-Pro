generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  PHYSICIAN
  NURSE
  SCHEDULER
}

enum TreatmentPlanStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  ON_HOLD
  COMPLETED
  DISCONTINUED
}

enum VisitStatus {
  UNASSIGNED
  SCHEDULED
  CONFIRMED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
  RESCHEDULED
}

enum TabletStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
}

enum PatientStatus {
  ENROLLED
  DISCHARGED
}

enum AlertSeverity {
  INFORMATIONAL
  URGENT
  CRITICAL
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users    User[]
  patients Patient[]
}

model User {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  name           String
  email          String
  role           UserRole
  createdAt      DateTime     @default(now())

  treatmentPlans TreatmentPlan[] @relation("OrderingPhysician")
  assignedVisits Visit[]         @relation("AssignedNurse")
  auditEvents    AuditLog[]

  @@unique([organizationId, email])
}

model Tablet {
  id         String       @id @default(uuid())
  identifier String       @unique
  status     TabletStatus @default(AVAILABLE)
  createdAt  DateTime     @default(now())

  currentPatient Patient?
}

model Patient {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  medicalRecordNumber String?
  firstName            String
  middleName           String?
  lastName             String
  dateOfBirth          DateTime
  phone                String?
  email                String?
  addressLine          String?
  city                 String?
  state                String?
  postalCode           String?

  allergies   String[] @default([])
  precautions String[] @default([])

  status       PatientStatus @default(ENROLLED)
  enrolledAt   DateTime      @default(now())
  dischargedAt DateTime?

  assignedTablet   Tablet? @relation(fields: [assignedTabletId], references: [id])
  assignedTabletId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  treatmentPlans TreatmentPlan[]
  visits         Visit[]
  measurements   Measurement[]
  alerts         Alert[]
  auditEvents    AuditLog[]
}

model TreatmentPlan {
  id         String   @id @default(uuid())
  patient    Patient  @relation(fields: [patientId], references: [id])
  patientId  String

  physician   User   @relation("OrderingPhysician", fields: [physicianId], references: [id])
  physicianId String

  diagnosis            String
  treatmentType        String
  description          String
  instructions          String?
  frequency             String
  startDate             DateTime
  endDate               DateTime?
  requiredVitals        String[] @default([])
  notifyIfSystolicOver  Int?
  notifyIfSystolicUnder Int?
  notifyIfSpo2Under     Int?

  status       TreatmentPlanStatus @default(DRAFT)
  signedAt     DateTime?
  signedBy     String?

  previousVersionId String?
  version           Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits Visit[]
}

/// checkInAt/checkOutAt form the digital footprint: a real timestamp
/// proving a specific nurse physically began and ended a visit,
/// visible immediately on the command center web app.
model Visit {
  id         String   @id @default(uuid())
  patient    Patient  @relation(fields: [patientId], references: [id])
  patientId  String

  treatmentPlan   TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])
  treatmentPlanId String?

  nurse   User?   @relation("AssignedNurse", fields: [nurseId], references: [id])
  nurseId String?

  serviceType  String
  scheduledAt  DateTime
  durationMin  Int         @default(45)
  status       VisitStatus @default(UNASSIGNED)
  instructions String?
  checkInAt    DateTime?
  checkOutAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  measurements Measurement[]
}

model Measurement {
  id         String   @id @default(uuid())
  patient    Patient  @relation(fields: [patientId], references: [id])
  patientId  String
  visit      Visit?   @relation(fields: [visitId], references: [id])
  visitId    String?

  kind       String
  systolic   Int?
  diastolic  Int?
  value      Float?
  unit       String
  measuredAt DateTime @default(now())
  source     String   @default("ios_app")

  createdAt DateTime @default(now())
  alerts    Alert[]
}

model Alert {
  id            String    @id @default(uuid())
  patient       Patient   @relation(fields: [patientId], references: [id])
  patientId     String
  measurement   Measurement? @relation(fields: [measurementId], references: [id])
  measurementId String?

  severity       AlertSeverity
  description    String
  acknowledgedAt DateTime?
  acknowledgedBy String?

  createdAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?
  patient      Patient? @relation(fields: [patientId], references: [id])
  patientId    String?
  action       String
  resourceType String
  resourceId   String
  createdAt    DateTime @default(now())
}